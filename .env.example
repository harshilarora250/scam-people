# ─────────────────────────────────────────────────────────────────────────────
# untitled-office-game — server configuration template
#
# Copy to `.env` and fill in values. `.env` is git-ignored.
# These variables are read ONLY by the server (server/config.ts).
# NEVER put secrets in variables prefixed with VITE_ — Vite exposes those to
# the browser. No VITE_* variables are needed.
#
# Full reference: ARCHITECTURE.md §13. Never commit real keys.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────
NODE_ENV=development
PORT=8787
# Public origin of the game (CORS + OpenRouter HTTP-Referer attribution).
PUBLIC_BASE_URL=http://localhost:5173
# debug | info | warn | error
LOG_LEVEL=info
# Set to true only when running behind a trusted reverse proxy.
TRUST_PROXY=false

# ── AI dialogue (OpenRouter) ─────────────────────────
# openrouter | mock | disabled
#   mock     = deterministic scripted replies, no network, no key needed
#   disabled = offline mode; characters use fallback lines
# If OPENROUTER_API_KEY is empty, the server falls back to `disabled`.
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_TITLE=untitled-office-game

# Any OpenRouter model id that supports structured outputs.
# Provisional default — confirmed by the Phase 5 eval (ARCHITECTURE.md §7.3).
AI_DIALOGUE_MODEL=anthropic/claude-haiku-5.5
# Comma-separated fallbacks tried when the primary model fails.
AI_DIALOGUE_FALLBACK_MODELS=google/gemini-3.5-flash-lite,deepseek/deepseek-v3.2
# Model for conversation summaries and other utility calls.
AI_UTILITY_MODEL=anthropic/claude-haiku-5.5
AI_MAX_OUTPUT_TOKENS=400
AI_REQUEST_TIMEOUT_MS=12000
AI_MAX_RETRIES=1

# ── Text-to-speech ───────────────────────────────────
# openrouter | elevenlabs | browser | disabled
#   browser = free built-in browser voices, synthesised client-side
#   elevenlabs = direct ElevenLabs adapter (future; not implemented yet)
TTS_PROVIDER=openrouter
# OpenRouter TTS model id (provisional, validated in Phase 6).
TTS_MODEL=hexgrad/kokoro-82m
# mp3 | pcm
TTS_FORMAT=mp3
TTS_MAX_CHARS=600
TTS_TIMEOUT_MS=10000

# ── Speech-to-text (push-to-talk) ────────────────────
# openrouter | disabled   (typed input always works)
STT_PROVIDER=openrouter
STT_MODEL=openai/whisper-large-v3-turbo
STT_MAX_SECONDS=30
STT_TIMEOUT_MS=10000

# ── ElevenLabs (future, optional) ────────────────────
# Only used when TTS_PROVIDER=elevenlabs.
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=

# ── Abuse & cost protection ──────────────────────────
RATE_LIMIT_WINDOW_MS=60000
# Requests per IP per window.
RATE_LIMIT_DIALOGUE_PER_WINDOW=30
RATE_LIMIT_VOICE_PER_WINDOW=40
# Global cap on provider calls per UTC day. 0 = unlimited.
# Set this on every public deployment.
DAILY_AI_REQUEST_BUDGET=0
